# Optional: copy to .env to override the demo defaults used by docker-compose.yml.
# Never commit a real .env.
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmanager
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=60
OVERDUE_SCAN_MINUTES=15
# Host port of the web app (change if already in use on your machine)
FRONTEND_PORT=5173
